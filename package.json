{
  "name": "backstage",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mprnl/backstage.git"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bun scripts/start.ts",
    "lint": "eslint",
    "lint:budget": "bun scripts/lint-budget.ts",
    "check:docs": "bun scripts/check-docs.ts",
    "boundaries": "depcruise app components lib packages proxy.ts instrumentation.ts",
    "verify": "bun run lint && bun run lint:budget && bun run check:docs && bunx tsc --noEmit && bun run typecheck:strict && bun run boundaries && bun run test:coverage",
    "typecheck:strict": "bun scripts/typecheck-strict.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:agent": "vitest run lib/__tests__/agent-scenarios.test.ts",
    "analyze": "ANALYZE=true bun run build",
    "cron:reminders": "bun scripts/cron-scheduler.ts reminders",
    "cron:daily-brief": "bun scripts/cron-scheduler.ts daily-brief",
    "cron:list": "bun scripts/cron-scheduler.ts --list",
    "module:add": "bun scripts/module-install.ts add",
    "module:list": "bun scripts/module-install.ts list",
    "module:doctor": "bun scripts/module-install.ts doctor",
    "module:update": "bun scripts/module-install.ts update",
    "module:remove": "bun scripts/module-install.ts remove",
    "module:enable": "bun scripts/module-install.ts enable",
    "module:disable": "bun scripts/module-install.ts disable",
    "reset:passkey": "bun scripts/reset-passkey.ts",
    "setup": "bun scripts/setup.ts",
    "setup:dev": "bun scripts/setup.ts --dev",
    "test:modele": "bun scripts/test-modele.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^14.1.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "google-auth-library": "^10.9.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.23.0",
    "next": "16.4.6",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.9",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.37",
    "nanoid": "3.3.20",
    "postcss": "8.5.33",
    "source-map-js": "1.2.2"
  }
}
