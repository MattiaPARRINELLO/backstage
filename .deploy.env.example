# Configuration de déploiement cPanel — copier vers .deploy.env et remplir

# Connexion SSH (rsync)
SSH_HOST=votre-domaine.com
SSH_USER=votre_utilisateur_cpanel
SSH_PORT=22
SSH_TARGET_DIR=/home/votre_utilisateur/apps/backstage

# Variables d'environnement production
NEXT_PUBLIC_API_URL=https://opencode.ai/zen/go/v1
IA_API_KEY=votre_api_key
GOOGLE_CLIENT_ID=votre_client_id
GOOGLE_CLIENT_SECRET=votre_client_secret
GOOGLE_REDIRECT_URI=https://votre-domaine.com/api/auth/google/callback
# "true" uniquement si le projet Google Cloud est en mode Testing (limite refresh ~7 j).
# En Production (même non vérifié), laisser vide : pas d'alerte d'âge, seul un
# refresh réellement échoué déclenche la bannière « à reconnecter ».
#GOOGLE_TESTING_EXPIRY=true
AUTH_SECRET=votre_secret_64_hex
OPENWEATHERMAP_API_KEY=votre_key
BRAVE_SEARCH_API_KEY=votre_key
# Secret partagé pour /api/cron/* — obligatoire en production (openssl rand -hex 32)
CRON_SECRET=votre_secret_64_hex
# Emploi du temps CESAR (sync auto + notifications 30 min avant cours)
CESAR_USERNAME=votre_login_cesar
CESAR_PASSWORD=votre_mot_de_passe_cesar

# Environnement Node à activer avant `npm install` (cPanel Node Selector).
# Vide si node est déjà dans le PATH du shell SSH.
DEPLOY_NODEENV=/home/votre_utilisateur/nodevenv/app/22/bin/activate

# Paire VAPID pour les notifications push (web-push generate-vapid-keys).
# La clé publique doit être identique à celle du build (ARG Docker).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=votre_vapid_public_key
VAPID_PRIVATE_KEY=votre_vapid_private_key
VAPID_SUBJECT=mailto:toi@example.com

# Token de bootstrap du premier enregistrement passkey (one-time).
# `bun run setup` en génère un pour le local ; en prod, gardez-le le temps du
# premier login puis retirez-le de l'environnement du serveur.
SETUP_TOKEN=votre_setup_token

# Domaine de la passkey / origine WebAuthn (obligatoires en production).
WEBAUTHN_RP_ID=votre-domaine.com
WEBAUTHN_ORIGIN=https://votre-domaine.com

# URL publique utilisée par les crons pour s'appeler eux-mêmes.
CRON_BASE_URL=https://votre-domaine.com

# Redémarrage via l'API cPanel (sinon Passenger tmp/restart.txt est utilisé).
# cPanel → Security → Manage API Tokens. Laisser vide si inutilisé.
# CPANEL_USER=votre_utilisateur_cpanel
# CPANEL_TOKEN=votre_token
