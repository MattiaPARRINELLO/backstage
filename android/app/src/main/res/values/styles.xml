<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème appliqué pendant l'ouverture : fond opaque, pas de barre, pas de
         flash blanc. Le lancement réel est le TWA piloté par Chrome. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/backstage_background</item>
        <item name="android:navigationBarColor">@color/backstage_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Écran d'appairage (affiché seulement si le lien backstage:// a été ouvert
         hors TWA). -->
    <style name="AppTheme.Pair" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/backstage_background</item>
        <item name="android:statusBarColor">@color/backstage_background</item>
        <item name="android:navigationBarColor">@color/backstage_background</item>
    </style>
</resources>
