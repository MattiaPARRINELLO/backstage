# BACKSTAGE — variables d'environnement
# Copier vers .env.local puis laisser `bun run setup` generer les secrets.
# Ne jamais committer .env.local.

# --- Obligatoires ---------------------------------------------------------
# Endpoint compatible OpenAI et sa cle.
NEXT_PUBLIC_API_URL=https://opencode.ai/zen/go/v1
IA_API_KEY=votre_cle_ia

# Signature des JWT de session (64 hex). Genere par `bun run setup`.
AUTH_SECRET=

# Passkey / WebAuthn.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Bootstrap one-time du premier enregistrement passkey.
# Genere par `bun run setup` ; a retirer apres le premier login en production.
SETUP_TOKEN=

# --- Notifications push (VAPID) ------------------------------------------
# Generer avec `bunx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com

# --- Cron -----------------------------------------------------------------
# Obligatoire en production (openssl rand -hex 32).
CRON_SECRET=
CRON_BASE_URL=http://localhost:3000

# --- Google (Calendar + Gmail) — optionnel --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Mettre "true" si le projet Google est en mode Testing.
# GOOGLE_TESTING_EXPIRY=true

# --- Microsoft To Do (sync des rappels) — optionnel -----------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --- Integrations — optionnel --------------------------------------------
OPENWEATHERMAP_API_KEY=
BRAVE_SEARCH_API_KEY=

# Emploi du temps CESAR.
CESAR_USERNAME=
CESAR_PASSWORD=
# CESAR_BASE=https://cesar.emineo-education.fr

# Empreinte SHA-256 de la cle de signature APK (assetlinks.json).
# ANDROID_CERT_SHA256=
