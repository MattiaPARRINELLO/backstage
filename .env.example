# BACKSTAGE — variables d'environnement
# Copier vers .env.local puis laisser `bun run setup` generer les secrets.
# Ne jamais committer .env.local.

# --- Developpement sans cle API (optionnel) ------------------------------
# `mock` remplace tous les appels IA par des reponses scriptees locales.
# Laisser vide (ou supprimer la ligne) pour utiliser le provider reel.
# Voir docs/contributing/premiere-pr.md et `bun run setup:dev`.
# AI_PROVIDER=mock

# Connexion locale sans passkey. Ignore en production.
# DEV_AUTH_BYPASS=true

# --- Obligatoires ---------------------------------------------------------
# Endpoint compatible OpenAI et sa cle.
# Facultatifs si AI_PROVIDER=mock.
NEXT_PUBLIC_API_URL=https://opencode.ai/zen/go/v1
IA_API_KEY=votre_cle_ia

# Signature des JWT de session (64 hex). Genere par `bun run setup`.
AUTH_SECRET=

# Passkey / WebAuthn.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Bootstrap one-time du premier enregistrement passkey.
# Genere par `bun run setup` ; a retirer apres le premier login en production.
SETUP_TOKEN=

# --- Notifications push (VAPID) ------------------------------------------
# Generer avec `bunx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com

# --- Cron -----------------------------------------------------------------
# Obligatoire en production (openssl rand -hex 32).
CRON_SECRET=
CRON_BASE_URL=http://localhost:3000

# --- Google (Calendar + Gmail) — optionnel --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Mettre "true" si le projet Google est en mode Testing.
# GOOGLE_TESTING_EXPIRY=true

# --- Microsoft To Do (sync des rappels) — optionnel -----------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --- Integrations — optionnel --------------------------------------------
OPENWEATHERMAP_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- GitHub (issues creees par l'agent) — optionnel -----------------------
# Jeton classique avec le seul scope "repo" (ou fin-grained : Issues: write,
# plus Contents: read si un module prive doit etre clone par le catalogue).
# GITHUB_REPO au format owner/nom. Sans ces deux variables, les outils
# create_github_issue / list_github_issues repondent "GitHub non configure".
# module:add ne lit pas ce jeton : un depot prive se clone avec les
# credentials de git (gh auth login + gh auth setup-git).
GITHUB_TOKEN=
GITHUB_REPO=

# Emploi du temps CESAR.
CESAR_USERNAME=
CESAR_PASSWORD=
# CESAR_BASE=https://cesar.emineo-education.fr

# Empreinte SHA-256 de la cle de signature APK (assetlinks.json).
# ANDROID_CERT_SHA256=

# Groq : extractions structurees des modules (scan des accreditations).
# Compatible OpenAI. Sans cle, ces taches retombent sur le modele de conversation.
GROQ_API_KEY=
# Plusieurs comptes : cles separees par des virgules, rotation sur quota.
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
# Attente entre deux extractions JSON enchainees (ms). Absent : 6 s avec une
# cle, 1,5 s des deux comptes dans GROQ_API_KEYS.
GROQ_SCAN_DELAY_MS=
